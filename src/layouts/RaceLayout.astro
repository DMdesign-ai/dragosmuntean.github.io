---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/race.css';

interface Props {
  title: string;
  description?: string;
  /** Ground the page opens on. Night for hero/log, snow for reading. */
  ground?: 'night' | 'snow';
  /** Registry code shown at the top right, e.g. "DOC RD-04 / WORK". */
  doc?: string;
}

const {
  title,
  description = 'Dragos Muntean — design technologist. Product design at TWINT, previously On.',
  ground = 'night',
  doc = 'DOC RD-00',
} = Astro.props;

const nav = [
  { label: 'Work',  href: '/work/'  },
  { label: 'Labs',  href: '/labs/'  },
  { label: 'Notes', href: '/notes/' },
  { label: 'About', href: '/about/' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class={ground === 'night' ? 'on-night' : 'on-snow'}>

  <div class="pacebar" aria-hidden="true"></div>

  <header class={`dochead ${ground === 'night' ? 'on-night' : 'on-snow'}`}>
    <div class="dochead__in">
      <a class="dochead__mark" href="/">DM</a>
      <nav class="dochead__nav" aria-label="Primary">
        {nav.map((n) => (
          <a class="dochead__link" href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <span class="registry dochead__doc">{doc}</span>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <script is:inline>
    // Reveal-on-enter. One observer, unobserved after firing, so scrolling
    // back up never replays — a re-run would be motion the reader didn't ask for.
    (function () {
      var els = document.querySelectorAll('[data-reveal]');
      if (!els.length) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        });
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>

  <footer class="docfoot on-night">
    <div class="docfoot__in">
      <span class="registry">Dragos Muntean · Zurich CH</span>
      <span class="registry">47.3769°N 8.5417°E</span>
      <nav class="docfoot__links" aria-label="Elsewhere">
        <a class="link hit" href="https://github.com/DMdesign-ai">GitHub</a>
        <a class="link hit" href="https://www.linkedin.com/in/dragos-muntean/">LinkedIn</a>
        <a class="link hit" href="/archive/">Archive</a>
      </nav>
    </div>
  </footer>

<style>
  /* The header is a fixed height so the hero can subtract it exactly.
     Every link fills that height and carries real padding, so the visible
     control IS the target. The old version had 10px text with an invisible
     44px pseudo-element around it: it measured fine, but people aim at what
     they can see, so it felt like tapping a word. */
  .dochead {
    position: sticky; top: 0; z-index: 20;
    height: var(--header-h); box-sizing: border-box;
    border-bottom: 1px solid var(--rule);
    backdrop-filter: blur(8px);
  }
  .dochead__in {
    height: 100%; max-width: 68rem; margin-inline: auto; padding-inline: var(--s6);
    display: flex; align-items: stretch; gap: var(--s2);
  }
  .dochead__mark, .dochead__link {
    display: flex; align-items: center;
    padding-inline: 0.875rem;
    font-family: var(--f-mono); font-size: var(--t-12);
    text-transform: uppercase; text-decoration: none;
    transition: color var(--dur-fast) var(--ease), background-color var(--dur-fast) var(--ease);
  }
  /* Pull the mark back by its own padding so "DM" still sits on the column
     edge that everything below it aligns to. */
  .dochead__mark {
    margin-left: -0.875rem;
    /* "DM" is only two letters; without a floor it shrinks to 38px on phones. */
    min-width: 2.75rem;
    font-weight: 600; letter-spacing: 0.2em; color: var(--fg);
  }
  .dochead__nav { display: flex; margin-right: auto; }
  .dochead__link { letter-spacing: 0.12em; color: var(--fg-dim); }
  /* Hover fills the whole target, which shows how big it really is. */
  .dochead__mark:hover, .dochead__link:hover {
    color: var(--fg); background-color: var(--raise);
  }
  /* Current page: a lime bar along the bottom of the target, on the rule. */
  .dochead__link[aria-current='page'] {
    color: var(--fg); box-shadow: inset 0 -2px 0 var(--hivis);
  }
  /* Keep the focus ring inside the header instead of spilling past it. */
  .dochead__mark:focus-visible, .dochead__link:focus-visible { outline-offset: -3px; }
  .dochead__doc { align-self: center; margin-left: var(--s4); white-space: nowrap; }

  @media (max-width: 640px) {
    /* Larger type on touch, tighter tracking and padding so all five
       targets still fit a 320px screen without wrapping. */
    .dochead__in { padding-inline: var(--s4); gap: 0; }
    .dochead__doc { display: none; }
    .dochead__mark, .dochead__link { padding-inline: 0.5rem; font-size: var(--t-14); }
    .dochead__mark { margin-left: -0.5rem; }
    .dochead__link { letter-spacing: 0.06em; }
  }

  /* No margin: every page's last band already carries its own padding, and a
     margin here shows the body ground through — which reads as a stray white
     strip on any page that ends on a dark section. */
  .docfoot { border-top: 1px solid var(--rule); }
  .docfoot__in {
    max-width: 68rem; margin-inline: auto; padding: var(--s8) var(--s6);
    display: flex; flex-wrap: wrap; gap: var(--s3) var(--s8); align-items: baseline;
  }
  .docfoot__links { display: flex; gap: var(--s6); margin-left: auto; }
  .docfoot__links a {
    font-family: var(--f-mono); font-size: var(--t-10); letter-spacing: var(--tr-mono);
    text-transform: uppercase; color: var(--fg-dim);
  }
  @media (max-width: 640px) {
    .docfoot__in { padding-inline: var(--s4); }
    .docfoot__links { margin-left: 0; }
  }
</style>
</body>
</html>
