---
import { getCollection, render } from 'astro:content';
import RaceLayout from '../../../layouts/RaceLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => !p.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const year = d.date.getFullYear();
const headline = d.figure;
---

<RaceLayout
  title={`${d.title} — Dragos Muntean`}
  description={d.description}
  ground="snow"
  doc={`DOC RD-04 / ${d.company?.toUpperCase() ?? 'WORK'}`}
>

  <!-- ── case hero: night, so the light case-study body reads as the document ── -->
  <section class="band casehero on-night">
    <a class="back registry hit" href="/v3/work/">← Work</a>
    <h1 class="casetitle">{d.title}</h1>
    <p class="casedesc">{d.description}</p>
    <dl class="specbar specbar--wide">
      <div><dt>Company</dt><dd>{d.company}</dd></div>
      <div><dt>Role</dt><dd>{d.role}</dd></div>
      <div><dt>Year</dt><dd>{year}</dd></div>
      <div><dt>Practice</dt><dd>{d.tags.join(', ')}</dd></div>
      {headline && <div><dt>Headline</dt><dd class="is-now">{headline}</dd></div>}
    </dl>
  </section>

  <!-- ── impact ─────────────────────────────────────────── -->
  {d.impact.length > 0 && (
    <section class="band on-snow tight">
      <span class="registry">Outcome</span>
      <ul class="impact">
        {d.impact.map((line) => <li>{line}</li>)}
      </ul>
    </section>
  )}

  <!-- ── body ───────────────────────────────────────────── -->
  <section class="band on-snow tight">
    <article class="prose">
      <Content />
    </article>
  </section>

  <!-- ── testimonials ───────────────────────────────────── -->
  {d.testimonials.length > 0 && (
    <section class="band on-snow tight">
      <span class="registry">On the record</span>
      <div class="quotes">
        {d.testimonials.map((t) => (
          <figure class="quote">
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              <b>{t.author}</b>
              <span>{t.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

<style>
  .band { padding: var(--s24) var(--s6); }
  .band > * { max-width: 68rem; margin-inline: auto; }
  /* `margin-inline: auto` above centres block children in the 68rem column but
     does nothing for inline boxes, which stay at the band's padding edge and
     read as labels floating off to the left. Put them on the same edge. */
  .band > .back,
  .band > .backlink,
  .band > .registry,
  .band > .rows-note,
  .band > .origin,
  .band > .related { margin-inline-start: max(0px, calc((100% - 68rem) / 2)); margin-inline-end: 0; }
  .band.tight { padding-block: var(--s12); }
  @media (max-width: 640px) { .band { padding: var(--s16) var(--s4); } }

  .casehero { padding-top: var(--s12); }
  .back { display: inline-block; margin-bottom: var(--s12); color: var(--fg-dim); text-decoration: none; }
  .back:hover { color: var(--fg); }
  .casetitle {
    font-size: var(--t-h1); letter-spacing: var(--tr-h1); line-height: 0.98;
    margin-bottom: var(--s6); max-width: 18ch;
  }
  .casedesc {
    font-size: var(--t-lead); line-height: 1.5; color: var(--fg-dim); margin-bottom: var(--s12);
  }

  .impact { list-style: none; padding: 0; margin: var(--s4) 0 0;
            display: grid; gap: 1px; background: var(--rule);
            border-block: 1px solid var(--rule); }
  .impact li {
    background: var(--ground); padding: var(--s4) 0;
    font-family: var(--f-display); font-size: var(--t-h3); font-weight: 500;
    letter-spacing: -0.012em; max-width: none;
  }

  .quotes { display: grid; gap: var(--s6); margin-top: var(--s4); }
  .quote { margin: 0; border-top: 1px solid var(--rule); padding-top: var(--s4); }
  .quote blockquote {
    margin: 0; font-family: var(--f-read); font-size: var(--t-lead);
    line-height: 1.5; max-width: 58ch;
  }
  .quote blockquote::before { content: '“'; }
  .quote blockquote::after  { content: '”'; }
  .quote figcaption { margin-top: var(--s3); display: flex; flex-wrap: wrap; gap: var(--s1) var(--s3); }
  .quote figcaption b {
    font-family: var(--f-mono); font-size: var(--t-10); letter-spacing: var(--tr-mono);
    text-transform: uppercase; font-weight: 600; color: var(--fg);
  }
  .quote figcaption span {
    font-family: var(--f-mono); font-size: var(--t-10); letter-spacing: var(--tr-mono);
    text-transform: uppercase; color: var(--fg-faint);
  }
</style>
</RaceLayout>
